# Copy to .env and fill in. .env is git-ignored.

# --- Recipe source -----------------------------------------------------------
# Directory containing the exported Paprika Markdown recipes.
RECIPES_DIR=./recipes
# Optional UID -> name mapping for categories (see fetch_categories.py).
CATEGORY_MAP_FILE=./category_map.yaml

# --- Local LLM (OpenAI-compatible API, e.g. LM Studio / Ollama / vLLM) -------
LOCAL_LLM_BASE_URL=http://localhost:1234/v1
LOCAL_LLM_API_KEY=not-needed
LOCAL_LLM_MODEL=

# --- Paprika cloud account (only used by fetch_categories.py) ----------------
PAPRIKA_EMAIL=
PAPRIKA_PASSWORD=
